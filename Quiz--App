#include <iostream>
using namespace std;

int main() {
    int score = 0, answer;

    cout << "===== Quiz App =====\n\n";

    // Question 1
    cout << "1. What is the capital of Egypt?\n";
    cout << "1. Cairo\n2. London\n3. Paris\n4. Rome\n";
    cin >> answer;
    if (answer == 1)
        score++;

    // Question 2
    cout << "\n2. How many days are there in a week?\n";
    cout << "1. 5\n2. 6\n3. 7\n4. 8\n";
    cin >> answer;
    if (answer == 3)
        score++;

    // Question 3
    cout << "\n3. Which language is this program written in?\n";
    cout << "1. Python\n2. Java\n3. C++\n4. C#\n";
    cin >> answer;
    if (answer == 3)
        score++;

    cout << "\n=====================\n";
    cout << "Your Score = " << score << " / 3\n";

    if (score == 3)
        cout << "Excellent!\n";
    else if (score == 2)
        cout << "Very Good!\n";
    else
        cout << "Keep Practicing!\n";

    return 0;
}
